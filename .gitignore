/target
**/*.rs.bk
Cargo.lock.bak

# IDE / editor
.idea/
.vscode/
*.iml

# OS junk
.DS_Store
Thumbs.db

# wingman local state / config (created in user repos, but ignore here too)
.wingman/
# wingman local state (created in user repos, but ignore here too)
.wingman/sessions/
.wingman/index.db*
.wingman/*.log

# Claude Code local state
.claude/

# VS Code extension build artifacts
editors/vscode/node_modules/
editors/vscode/dist/

# Web panel build artifacts. `crates/wingman-cli/build.rs` embeds panel/dist when
# it exists and substitutes a placeholder when it does not, so a clone without
# these still builds.
panel/node_modules/
panel/dist/

# Desktop notifier build artifacts. It is a detached cargo workspace with its
# own target dir (docs/decisions/0018), so `/target` above does not cover it.
desktop/notifier/target/
# `tauri-build` regenerates gen/schemas on every build; it is ~300KB of
# JSON referenced only by an editor `$schema` hint in capabilities/.
desktop/notifier/gen/
desktop/notifier/ui/node_modules/
desktop/notifier/ui/dist/
