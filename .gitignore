/target
**/*.rs.bk
Cargo.lock.bak

# IDE / editor
.idea/
.vscode/
*.iml

# OS junk
.DS_Store
Thumbs.db

# wingman local state / config (created in user repos, but ignore here too)
.wingman/
# wingman local state (created in user repos, but ignore here too)
.wingman/sessions/
.wingman/index.db*
.wingman/*.log

# Claude Code local state
.claude/

# VS Code extension build artifacts
editors/vscode/node_modules/
editors/vscode/dist/

# Web panel build artifacts. `crates/wingman-cli/build.rs` embeds ui/dist when
# it exists and substitutes a placeholder when it does not, so a clone without
# these still builds.
ui/node_modules/
ui/dist/
